# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
htmlcov/
.coverage

# Audio output artifacts (large binaries).
# Recursive: DT-94/DT-95 render demos into output/v3_renders/, and renders made
# from the D-029 private corpus are local/internal-only — they must never be
# committed regardless of how deep the output tree gets.
output/**/*.wav
output/**/*.mp3
output/**/*.flac
output/*.wav

# Dataset governance (docs/data/DATASET_GOVERNANCE.md): raw/restricted/derived
# audio never enters git; only data/manifests/ and data/licenses/ are tracked.
data/local/
data/restricted/
data/derived/
# Artist consent forms contain PII: only the index is tracked (Tier P).
data/licenses/artist/*
!data/licenses/artist/INDEX.md

# CI regression artifacts (written on failure)
artifacts/

# Agent/orchestrator internals
.agent/
.autoclaw/

# Environment
.env
.env.local

# Private paired-corpus per-run reports (titles/metrics) stay local
reports/evaluations/paired-corpus/2*/
